{
  "name": "interactive-learning-editor",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop editor for interactive learning web units",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
